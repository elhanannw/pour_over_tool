{
  "name": "pour-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:scan": "python scripts/security-scan.py",
    "security:audit": "npm audit",
    "format": "prettier --write src e2e vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src e2e vite.config.ts playwright.config.ts",
    "package": "python scripts/package.py"
  },
  "overrides": {
    "glob": "14.0.6"
  },
  "dependencies": {
    "decimal.js": "10.5.0",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "4.1.12"
  }
}
